{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "checking",
          "wallet",
          "credit_card",
          "loan",
          "brokerage"
        ]
      },
      "last4": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      },
      "balance": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "as_of": {
        "type": "string",
        "format": "date"
      },
      "apr": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "credit_limit": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "min_payment": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "floor": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "overdraft_fee": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      }
    },
    "required": [
      "id",
      "name",
      "kind",
      "last4",
      "balance",
      "as_of"
    ],
    "additionalProperties": false
  }
}
