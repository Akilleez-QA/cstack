{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "payee": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?\\d+(\\.\\d{1,2})?$"
          },
          "cadence": {
            "enum": [
              "weekly",
              "biweekly",
              "monthly",
              "quarterly",
              "yearly",
              "once"
            ]
          },
          "next_renewal": {
            "type": "string",
            "format": "date"
          },
          "last_used": {
            "type": "string",
            "format": "date"
          },
          "keep": {
            "type": "boolean"
          },
          "account": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "unused",
                "duplicate",
                "renewal_soon"
              ]
            }
          },
          "matching_transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "payee": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "pattern": "^-?\\d+(\\.\\d{1,2})?$"
                },
                "account": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "date",
                "payee",
                "amount",
                "account"
              ],
              "additionalProperties": false
            }
          },
          "requires_approval": {
            "const": true
          }
        },
        "required": [
          "id",
          "payee",
          "amount",
          "cadence",
          "next_renewal",
          "account",
          "flags",
          "matching_transactions",
          "requires_approval"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "date",
    "recommendations"
  ],
  "additionalProperties": false
}
