{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "assumptions": {
      "type": "string",
      "minLength": 1
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "opening": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closing": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_balance": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "reconciliation_diff": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reconciliation_status": {
            "enum": [
              "comparable",
              "missing_account_or_month_end_snapshot"
            ]
          }
        },
        "required": [
          "id",
          "opening",
          "closing",
          "snapshot_balance",
          "snapshot_as_of",
          "reconciliation_diff",
          "reconciliation_status"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "income": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "spend": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        },
        "required": [
          "category",
          "income",
          "spend"
        ],
        "additionalProperties": false
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "account_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "amount",
          "description",
          "account_id"
        ],
        "additionalProperties": false
      }
    },
    "uncategorized": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "account_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "amount",
          "description",
          "account_id"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "draft_next_step": {
            "type": "string",
            "minLength": 1
          },
          "requires_approval": {
            "const": true
          }
        },
        "required": [
          "draft_next_step",
          "requires_approval"
        ],
        "additionalProperties": false
      }
    },
    "requires_approval": {
      "const": true
    }
  },
  "required": [
    "month",
    "assumptions",
    "accounts",
    "categories",
    "unmatched",
    "uncategorized",
    "actions",
    "requires_approval"
  ],
  "additionalProperties": false
}
