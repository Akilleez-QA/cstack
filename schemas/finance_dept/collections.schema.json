{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "counterparty": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "next_action": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "tax_debt",
          "receivable",
          "asset_sale"
        ]
      },
      "principal": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "annual_rate": {
        "type": [
          "number",
          "string"
        ],
        "pattern": "^\\d+(\\.\\d+)?$"
      },
      "start_date": {
        "type": "string",
        "format": "date"
      }
    },
    "required": [
      "id",
      "kind",
      "counterparty",
      "principal",
      "start_date",
      "status",
      "next_action",
      "evidence"
    ],
    "additionalProperties": false
  }
}
