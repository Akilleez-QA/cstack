{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "format": "date"
      },
      "from": {
        "type": "string",
        "minLength": 1
      },
      "to": {
        "type": "string",
        "minLength": 1
      },
      "amount": {
        "type": [
          "string",
          "number"
        ],
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "status": {
        "enum": [
          "planned",
          "done"
        ]
      }
    },
    "required": [
      "date",
      "from",
      "to",
      "amount",
      "status"
    ],
    "additionalProperties": false
  }
}
