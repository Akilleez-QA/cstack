# NAMES ONLY. Real values live in Vercel project env (Production) and on each machine. Never commit or paste them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SHIELDS_ALLOWED_USER_ID=            # the single Clerk user id allowed to change levels
SHIELDS_HMAC_MAIN_RIG=              # 32-byte hex, generated ON host-a, copied to Vercel env by the owner
SHIELDS_HMAC_BOX=                   # 32-byte hex, generated ON the box
UPSTASH_REDIS_REST_URL=             # Vercel Marketplace -> Upstash Redis (ledger + state store)
UPSTASH_REDIS_REST_TOKEN=
SHIELDS_MACHINES=host-a,box
SHIELDS_CLERK_FAPI_HOST=             # optional; Clerk Frontend API host for CSP. Default: decoded from the publishable key
LEDGER_ENFORCE=                     # DECISION-004. Unset/0 = log-only (default). 1 = level 0 needs a quorum-witnessed intent
LEDGER_ROSTER_JSON=                 # PUBLIC keys only: {"quorum":2,"witnesses":{name:hex},"writers":{name:{"pub":hex,"node":origin}}}
COSIGN_ENFORCE=                     # Phone co-sign for all-clear. Unset/0 = verify + record only (default). 1 = level 0 needs it
COSIGN_PASSKEY_JSON=                # PUBLIC only: {"credentialId":b64url,"spki":b64 DER,"rpId":host,"origins":["https://host"]}
